# OMC runtime state — per-session journals + working state, never committed.
# The `**/` prefix matters: a pattern containing a slash is anchored to this
# file's directory, so the old `.omc/state/` never matched `cli/.omc/state/`,
# and six runtime files were tracked there until 2026-09-08.
**/.omc/sessions/
**/.omc/state/
**/.omc/logs/
**/.omc/artifacts/
**/.omc/handoffs/
.omc/notepad.md
.omc/project-memory.json
# `.omc/skills/**` stays committable on purpose (project-scoped skills).

# Local Claude settings overrides
.claude/settings.local.json

# OS
.DS_Store

# c1-reference-project — example tree build artefacts (FR-GL-028).
# Each example tree under examples/* ships its own per-language
# .gitignore for fine-grained ignores ; these patterns guarantee no
# build output ever reaches the Forge repo.
examples/*/build/
examples/*/target/
examples/*/cli/
examples/*/node_modules/
examples/*/.dart_tool/
examples/*/.cargo/
examples/*/coverage/

# a7-forge-upgrade — session-only conflict listing, never committed (FR-UP-012)
.merge-conflicts

# Local parallel worktrees (per-feature isolation). Tracked branches live
# in git's worktree metadata, not in the tree.
.worktrees/
