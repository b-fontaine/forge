# <!-- Audit: B.1.4 (part of b1-scaffolder, buf codegen config) -->
#
# Code-generation configuration for <project-name>'s proto contracts.
# Drives two outputs from a single proto source :
#   - Rust stubs (server + client) consumed by backend/crates/grpc-api/
#   - Dart stubs consumed by frontend/lib/generated/protos/
#
# Regenerate both with : `task proto` (or `cd shared/protos && buf generate`).

version: v2

managed:
  enabled: true
  # REQUIRED. The connectrpc/go plugin below needs a Go import path for every file and
  # no .proto here declares `option go_package`; without this override `buf generate`
  # (so `task proto`) exits 1 on a freshly scaffolded project. This 1.0.0 manifest is
  # what `forge init --archetype full-stack-monorepo` renders for BOTH versions —
  # scaffold-plan-2.0.0.yaml inherits this entry rather than the 2.0.0 overlay's —
  # so the fix has to live here too (t8-codegen-render-builds, FR-T8CRB-002).
  override:
    - file_option: go_package_prefix
      value: <reverse-domain>/<project-name>/gen/go

plugins:
  # ── Rust (tonic — server + client) ──
  - remote: buf.build/community/neoeinstein-tonic:v0.4.0
    out: ../../backend/crates/grpc-api/src/generated
    opt:
      - no_server=false
      - no_client=false
      # buf isolates each plugin's output, so tonic's generated `include!` would
      # reference the prost file it cannot see: without this the plugin fails with
      # "read <pkg>.rs: file does not exist" (t8-codegen-render-builds, FR-T8CRB-003).
      - no_include=true

  # ── Rust (prost — messages) ──
  - remote: buf.build/community/neoeinstein-prost:v0.4.0
    out: ../../backend/crates/grpc-api/src/generated

  # ── Dart (messages + gRPC clients) ──
  - remote: buf.build/protocolbuffers/dart:v21.1.2
    out: ../../frontend/lib/generated/protos

  # ── Connect codegen — Go (forward-compat for B.6/B.7 ; FR-T5-CC-001) ──
  - remote: buf.build/connectrpc/go:v1.19.2
    out: ../../backend/crates/grpc-api/src/generated/connect/go
    opt:
      - paths=source_relative

  # ── Connect codegen — TS (Connect v2 / Protobuf-ES v2 ; FR-T5-CC-002) ──
  # Connect v2 retired protoc-gen-connect-es ; service descriptors come
  # from @bufbuild/protoc-gen-es ≥ 2.2.0. Runtime: @connectrpc/connect@^2.
  - remote: buf.build/bufbuild/es:v2.2.0
    out: ../../frontend/lib/generated/connect/ts
    opt:
      - target=ts
      - import_extension=js

  # ── Connect codegen — Dart (OFFICIAL connectrpc/connect-dart ; FR-T5-CC-003) ──
  # Replaces abandoned skadero/protoc-gen-connect-dart-community.
  - remote: buf.build/connectrpc/dart:v1.0.0
    out: ../../frontend/lib/generated/connect/dart
