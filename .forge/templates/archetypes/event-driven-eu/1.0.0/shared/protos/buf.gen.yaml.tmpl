# <!-- Audit: B.6.2 (b6-2-scaffolder) — codegen manifest -->
# Code generation for <project-name>'s proto contracts (transport.yaml). Drives the
# Rust gRPC/Connect stubs + the TS client from a single proto source. Regenerate
# with `task proto` (or `buf generate`). Pins for the Connect Rust crate family
# (connectrpc / neoeinstein-tonic / neoeinstein-prost) live in transport.yaml, not
# here (that standard is the single source of truth for transport pins).
#
# event-driven-eu has no Flutter surface (ADR-B6-1-004), so no Dart plugin ships.
version: v2

managed:
  enabled: true
  # REQUIRED, not decoration. The connectrpc/go plugin below needs a Go import path
  # for every file, and no .proto here declares `option go_package` — without this
  # override `buf generate` (so `task proto`) exits 1 on a freshly scaffolded project
  # with "unable to determine Go import path" (t8-codegen-render-builds, FR-T8CRB-002).
  # The value is built from the scaffold placeholders so each project owns its own
  # generated Go path instead of sharing a literal.
  override:
    - file_option: go_package_prefix
      value: <reverse-domain>/<project-name>/gen/go

plugins:
  # ── Rust (tonic — server + client) — Article VII.2 gRPC ──
  - remote: buf.build/community/neoeinstein-tonic:v0.4.0
    out: ../../backend/gen/rust
    opt:
      - no_server=false
      - no_client=false
      # buf runs every plugin in its own isolated output, so tonic's generated
      # `include!` would reference the prost file it cannot see: without this the
      # plugin fails with "read <pkg>.rs: file does not exist", even though prost
      # writes exactly that file (t8-codegen-render-builds, FR-T8CRB-003).
      - no_include=true
  # ── Rust (prost — messages) ──
  - remote: buf.build/community/neoeinstein-prost:v0.4.0
    out: ../../backend/gen/rust
  # ── Connect codegen — TS (Connect v2 / Protobuf-ES v2) ──
  - remote: buf.build/bufbuild/es:v2.2.0
    out: gen/ts
    opt:
      - target=ts
      - import_extension=js
  # ── Connect codegen — Go (forward-compat) ──
  - remote: buf.build/connectrpc/go:v1.20.0
    out: gen/go
    opt:
      - paths=source_relative
