// Audit: B.9.3 (b9-3-shared-oidc, FR-B9-3-001/003/004)
//
// Building the authorization request. Every random value below comes from the Web
// Crypto CSPRNG via oauth4webapi's generators (crypto.getRandomValues underneath);
// Math.random is never acceptable for a value whose unpredictability is what makes
// the check meaningful.

import * as oauth from "oauth4webapi";
import type { OidcProviderConfig } from "./config";
import { surfaceOf } from "./config";
import { resolveAuthorizationServer } from "./discovery";
import type { PendingAuthorization } from "./pending";

export interface AuthorizationRequest {
  /** Where to send the user agent. */
  url: string;
  /** What the callback will need in order to verify what comes back. */
  pending: PendingAuthorization;
}

export async function beginAuthorization(
  config: OidcProviderConfig,
): Promise<AuthorizationRequest> {
  const as = await resolveAuthorizationServer(config);
  const surface = surfaceOf(config);

  if (!as.authorization_endpoint) {
    throw new Error(
      `provider metadata for ${config.issuer} declares no authorization_endpoint`,
    );
  }

  // PKCE (FR-B9-3-001/003). S256 only — `plain` defeats the entire mechanism by
  // sending the verifier in the clear as its own challenge.
  const codeVerifier = oauth.generateRandomCodeVerifier();
  const codeChallenge = await oauth.calculatePKCECodeChallenge(codeVerifier);

  // Distinct values with distinct jobs (FR-B9-3-004): `state` binds the callback to
  // THIS browser transaction, `nonce` binds the ID token to it. Neither substitutes
  // for the other, so neither is derived from the other.
  const state = oauth.generateRandomState();
  const nonce = oauth.generateRandomNonce();

  const url = new URL(as.authorization_endpoint);
  url.searchParams.set("client_id", surface.clientId);
  url.searchParams.set("redirect_uri", surface.redirectUri);
  url.searchParams.set("response_type", "code");
  url.searchParams.set("scope", config.scopes.join(" "));
  url.searchParams.set("code_challenge", codeChallenge);
  url.searchParams.set("code_challenge_method", "S256");
  url.searchParams.set("state", state);
  url.searchParams.set("nonce", nonce);

  return { url: url.toString(), pending: { state, nonce, codeVerifier } };
}
